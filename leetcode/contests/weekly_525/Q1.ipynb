   "source": [
    "class Solution:\n",
    "    def calculateScore(self, a: int, b: int) -> int:\n",
    "        s1 = a.bit_count()\n",
    "        s2 = b.bit_count()\n",
    "\n",
    "        if s1 >= s2:\n",
    "            return s1 * s2\n",
    "        return s2 // s1"
   ]
  },
